# Postgres connection (Neon in production). Leave unset in development to use an embedded
# PGlite database under apps/server/.data.
DATABASE_URL=

# Ed25519 private key (PKCS#8 PEM, base64-encoded) that signs license tokens. The matching public
# key is built into the desktop app (apps/desktop/src/main/license-public-key.ts).
# Generate a pair with: node scripts/license-keys.ts
LICENSE_SIGNING_KEY=

# scrypt hash of the admin password: printf '%s' 'the password' | node apps/server/scripts/hash-password.ts
ADMIN_PASSWORD_HASH=

# At least 32 random characters; signs admin session cookies.
ADMIN_SESSION_SECRET=
