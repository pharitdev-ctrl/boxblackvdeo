{
  "name": "boxblack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/server",
    "dev": "npm run dev -w @boxblack/desktop",
    "dev:server": "npm run dev -w @boxblack/server",
    "m0:spike": "node scripts/m0-spike.ts",
    "m0:restore": "node scripts/m0-restore.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
